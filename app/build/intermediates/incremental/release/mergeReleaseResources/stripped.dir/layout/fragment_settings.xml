<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tws_background">

    <include layout="@layout/toolbar_brand" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tws_green"
        android:text="@string/settings"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/rowProfile"
            style="@style/SettingsRow"
            android:text="@string/profile_information" />

        <TextView
            android:id="@+id/rowNotifications"
            style="@style/SettingsRow"
            android:text="@string/notification_preferences" />

        <TextView
            android:id="@+id/rowLanguage"
            style="@style/SettingsRow"
            android:text="@string/language_label" />

        <TextView
            android:id="@+id/rowOfflineData"
            style="@style/SettingsRow"
            android:text="@string/offline_data_sync" />

        <TextView
            android:id="@+id/rowPrivacy"
            style="@style/SettingsRow"
            android:text="@string/privacy_security" />

        <TextView
            android:id="@+id/rowLogout"
            style="@style/SettingsRow"
            android:text="@string/log_out" />

    </LinearLayout>
</LinearLayout>
