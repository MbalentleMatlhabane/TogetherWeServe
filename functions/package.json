{
  "name": "togetherweserve-functions",
  "description": "Custom REST API for TogetherWeServe, exposed via Firebase Cloud Functions.",
  "engines": { "node": "18" },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
